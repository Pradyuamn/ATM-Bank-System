account = {
    "name": "Pradyumn Borade",
    "pin": "708090",
    "balance": 15345
}

menu = ["Check Balance", "Deposit", "Withdraw", "Exit"]
bank_info = ("Welcome to ATM", "Secure Banking System")

print(bank_info[0])
print(bank_info[1])

attempts = 0
while attempts < 3:
    user_pin = input("Enter PIN: ")
    
    if user_pin == account["pin"]:
        print(f"Login Successful  Welcome, {account['name']}!")
        
        while True:
            print(f"\n--- MENU --- [{account['name']}]")
            for i, option in enumerate(menu, start=1):
                print(i, option)
            
            choice = input("Enter choice: ")
            
            if choice == "1":
                print(f"Account Holder : {account['name']}")
                print(f"Your Balance   : ₹{account['balance']}")
                
            elif choice == "2":
                amount = int(input("Enter deposit amount: "))
                account["balance"] += amount
                print(f"₹{amount} Deposited Successfully ✅")
                
            elif choice == "3":
                amount = int(input("Enter withdrawal amount: "))
                if amount <= account["balance"]:
                    account["balance"] -= amount
                    print(f"₹{amount} Withdrawn Successfully ✅")
                else:
                    print("Insufficient Balance ")
                    
            elif choice == "4":
                print(f"Thank you, {account['name']}! Have a great day ")
                break
            else:
                print("Invalid choice. Please try again.")
        break
    
    else:
        attempts += 1
        remaining = 3 - attempts
        if attempts == 3:
            print("Account Blocked ❌")
        else:
            print(f"Wrong PIN! {remaining} attempt(s) remaining.")
